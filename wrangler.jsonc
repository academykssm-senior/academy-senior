{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "academy-senior",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/server.js",
  "assets": {
    "directory": "dist/client"
  },
  "routes": [
    {
      "pattern": "senior.myacademy.my",
      "custom_domain": true
    }
  ]
}
