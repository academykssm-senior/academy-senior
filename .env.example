# AcadeMY Senior — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
#
# Same existing AcadeMY Supabase project as Junior (auth.users / profiles).
# Senior has its own host-only session — not shared cookies with www.

# ── Shared Supabase project (anon only) ──────────────────────────────
VITE_SUPABASE_URL=https://aojrbxoqbgyxmfljqpqj.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

SUPABASE_URL=https://aojrbxoqbgyxmfljqpqj.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY must never appear in client code or VITE_ vars

# ── Application ───────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173

# ── Environment ───────────────────────────────────────────────────────
NODE_ENV=development
