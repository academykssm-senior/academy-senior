# AcadeMY Senior — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
#
# See docs/DECISIONS.md ADR-007 and ADR-017.
# Same existing AcadeMY Supabase project as www.myacademy.my — not a second project.

# ── Shared Supabase (browser + server anon) ──────────────────────────
# Browser-safe public keys (safe to expose to client; RLS required)
VITE_SUPABASE_URL=https://aojrbxoqbgyxmfljqpqj.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only aliases of the same public values (never put SERVICE_ROLE here)
SUPABASE_URL=https://aojrbxoqbgyxmfljqpqj.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY must never appear in client code or VITE_ vars

# ── Application ───────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
VITE_MAIN_APP_URL=https://www.myacademy.my

# ── Environment ───────────────────────────────────────────────────────
NODE_ENV=development
