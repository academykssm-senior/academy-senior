# AcadeMY Senior — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
#
# See docs/DECISIONS.md ADR-007 — secrets via env vars only.
# See .kiro/steering/security.md for handling rules.

# ── Supabase (Senior project — separate from Junior) ──────────────────
# Browser-safe public keys (safe to expose to client)
VITE_SUPABASE_URL=https://your-senior-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only keys (never expose to browser)
SUPABASE_URL=https://your-senior-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY is server-only and must never appear in client code

# ── Application ───────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:3000

# ── Environment ───────────────────────────────────────────────────────
NODE_ENV=development
